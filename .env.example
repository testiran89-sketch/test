# Network (put a REAL RPC URL here; do not leave placeholder values)
# Example Alchemy: https://polygon-mainnet.g.alchemy.com/v2/<REAL_API_KEY>
# Public fallback (rate-limited): https://polygon-rpc.com
POLYGON_RPC_URL=
POLYGON_FALLBACK_RPC_URL=https://polygon-rpc.com
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Addresses (Polygon)
AAVE_POOL=0x794a61358d6845594f94dc1db02a252b5b4814ad
USDC=0x2791bca1f2de4661ed88a30c99a7a9449aa84174
CRV=0x172370d5cd63279efa6d502dab29171933a610af
