# Network (put a REAL RPC URL here; do not leave placeholder values)
# Example Alchemy: https://polygon-mainnet.g.alchemy.com/v2/<REAL_API_KEY>
# Public fallback (rate-limited): https://polygon-rpc.com
POLYGON_RPC_URL=
POLYGON_FALLBACK_RPC_URL=https://polygon-rpc.com
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Addresses (Polygon)
AAVE_POOL=0x794a61358d6845594f94dc1db02a252b5b4814ad
USDC=0x2791bca1f2de4661ed88a30c99a7a9449aa84174
CRV=0x172370d5cd63279efa6d502dab29171933a610af
SUSHISWAP_ROUTER=0x1b02da8cb0d097eb8d57a175b88c7d8b47997506
QUICKSWAP_ROUTER=0xa5e0829caced8ffdd4de3c43696c57f7d7a678ff

# Deployed contract address (after running: npm run deploy)
ARB_CONTRACT=0xYOUR_DEPLOYED_CONTRACT

# Strategy
FLASH_AMOUNT_USDC=100000
SLIPPAGE_BPS=30
FLASH_FEE_BPS=9
REQUIRE_NON_NEGATIVE=1
# Optional custom route paths (comma-separated addresses)
# BUY_PATH=0x2791bca1f2de4661ed88a30c99a7a9449aa84174,0x0d500b1d8e8ef31e21c99d1db9a6444d3adf1270,0x172370d5cd63279efa6d502dab29171933a610af
# SELL_PATH=0x172370d5cd63279efa6d502dab29171933a610af,0x0d500b1d8e8ef31e21c99d1db9a6444d3adf1270,0x2791bca1f2de4661ed88a30c99a7a9449aa84174
# You can also try WETH routing in custom paths:
# BUY_PATH=0x2791...,0x7ceb23fd6bc0add59e62ac25578270cff1b9f619,0x1723...
# Optional sanity rails (USDC/CRV price)
# Set 0 to disable. Keep disabled by default to avoid false blocks on large size impact.
MAX_BUY_PRICE_USDC=0
MIN_SELL_PRICE_USDC=0
# Recommended: minimum net profit before gas (USDC). Prevent trading tiny edges.
MIN_NET_USDC=20
